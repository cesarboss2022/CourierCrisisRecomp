@@ -0,0 +1,42 @@
+// launcher_courier_text.h -- plain-language messages for the Courier Crisis
+// launcher. Included by launcher_imgui.cpp; depends only on the standard
+// library and launcher_i18n.h.
+#pragma once
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+// Turns a provider/runtime error into something a player can act on, keeping
+// the original text after it for bug reports. Unknown errors pass through.
+static std::string courier_friendly_error(const char* raw) {
+    const std::string err = raw && raw[0] ? raw : "";
+    auto pt = [](const char* en, const char* pt_) {
+        return std::string(launcher_i18n_pair(en, pt_));
+    };
+    std::string head;
+    const char* trusted = std::strstr(err.c_str(), "trusted plugin is unavailable");
+    if (trusted) {
+        const char* colon = std::strchr(trusted, ':');
+        std::string id = colon ? colon + 1 : "";
+        while (!id.empty() && (id.front() == ' ')) id.erase(id.begin());
+        head = pt("The enhancement \"", "O aprimoramento \"") + id +
+               pt("\" is not part of this game executable. This happens when an old "
+                  "CourierCrisis_Recompiled.exe is opened next to newer files. "
+                  "Download the latest release and open the new executable.",
+                  "\" não faz parte deste executável. Isso acontece quando um "
+                  "CourierCrisis_Recompiled.exe antigo é aberto junto de arquivos "
+                  "novos. Baixe a versão mais recente e abra o executável novo.");
+    } else if (std::strstr(err.c_str(), "disc") && std::strstr(err.c_str(), "not")) {
+        head = pt("The disc image was not accepted. Use your own Courier Crisis (USA, "
+                  "SLUS-00442) image in .cue/.bin or .chd format.",
+                  "A imagem do disco não foi aceita. Use a sua própria imagem do "
+                  "Courier Crisis (USA, SLUS-00442) em .cue/.bin ou .chd.");
+    } else if (std::strstr(err.c_str(), "BIOS") || std::strstr(err.c_str(), "bios")) {
+        head = pt("The BIOS could not be used. Press \"Use OpenBIOS\" on the Settings "
+                  "page or pick your own BIOS file.",
+                  "Não foi possível usar a BIOS. Use o botão \"Usar OpenBIOS\" em "
+                  "Configurações ou escolha o seu arquivo de BIOS.");
+    }
+    if (head.empty()) return err.empty() ? std::string() : err;
+    return head + "\n" + pt("Technical detail: ", "Detalhe técnico: ") + err;
+}
