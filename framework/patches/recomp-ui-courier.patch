+int parse_mod_value(const ModRow &r, const char *v) {
+    if (r.kind <= 1) return (!std::strcmp(v, "true") || !std::strcmp(v, "1")) ? 1 : 0;
+    if (r.kind == 2) {
+        for (size_t i = 0; i < r.values.size(); ++i)
+            if (r.values[i] == v) return (int)i;
+        return 0;
+    }
