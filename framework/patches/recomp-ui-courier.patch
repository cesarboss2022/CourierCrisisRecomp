+
+struct CcRow {
+    const char* pkg;
+    const char* feat;
+    int         section;
+    const char* name_en;
+    const char* name_pt;
+    const char* desc_en;
+    const char* desc_pt;
+    bool        expand;      // show every option under the switch
+    const char* primary;     // else: only this option (may be nullptr = none)
+    const char* linked_pkg;  // hidden feature that follows this switch
+    const char* linked_feat;
+    const char* linked_pkg2;
+    const char* linked_feat2;
+};
