+// ---- widgets ----------------------------------------------------------------
+static bool cc_toggle(const char* id, bool* v, const LauncherTheme& th) {
+    const float h = ImGui::GetFrameHeight() * 0.82f;
+    const float w = h * 1.85f;
+    const ImVec2 p = ImGui::GetCursorScreenPos();
+    ImGui::InvisibleButton(id, ImVec2(w, h));
+    const bool hovered = ImGui::IsItemHovered();
+    bool changed = false;
+    if (ImGui::IsItemClicked()) { *v = !*v; changed = true; }
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    const ImU32 bg = *v ? imcol(th.accent, hovered ? 1.0f : 0.92f)
+                        : imcol(th.control_hovered, hovered ? 1.0f : 0.85f);
+    dl->AddRectFilled(p, ImVec2(p.x + w, p.y + h), bg, h * 0.5f);
+    dl->AddRect(p, ImVec2(p.x + w, p.y + h), imcol(th.border, 0.9f), h * 0.5f);
+    const float r = h * 0.5f - 3.0f;
+    const float cx = *v ? p.x + w - h * 0.5f : p.x + h * 0.5f;
+    dl->AddCircleFilled(ImVec2(cx, p.y + h * 0.5f), r,
+                        *v ? ImGui::GetColorU32(ImVec4(0.08f, 0.07f, 0.05f, 1.0f))
+                           : imcol(th.text_muted, 1.0f));
+    return changed;
+}
