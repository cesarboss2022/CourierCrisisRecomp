+struct CcListed { RecompLauncherCModFeature f; const CcRow* row; int section; int order; };
+
+// The options a card shows under its switch (only while the feature is on).
+static void cc_card_options(LauncherModel* m, const CcListed& it,
+                            std::vector<RecompLauncherCModOption>* out) {
+    const RecompLauncherCModFeature& f = it.f;
+    if (!f.enabled || f.option_count <= 0 || !it.row || !(it.row->expand || it.row->primary)) return;
+    for (int j = 0; j < f.option_count; ++j) {
+        RecompLauncherCModOption o{};
+        if (!m->mods->feature_option_get(m->mods->ctx, f.package_id, f.id, j, &o)) continue;
+        if (!it.row->expand && std::strcmp(o.id, it.row->primary)) continue;
+        if (o.type == RECOMP_MOD_OPTION_BINDING || o.type == RECOMP_MOD_OPTION_TEXT) continue;
+        cc_localize_option(f, &o);
+        out->push_back(o);
+    }
+}
+
+static const float kCcPadX = 16.0f, kCcPadY = 13.0f, kCcToggleGap = 14.0f;
+
+static float cc_card_height(LauncherModel* m, const CcListed& it, float card_w) {
+    const bool pt = std::strcmp(launcher_i18n_language(), "pt") == 0;
+    const char* desc = it.row ? (pt ? it.row->desc_pt : it.row->desc_en) : it.f.description;
+    const float toggle_w = ImGui::GetFrameHeight() * 0.82f * 1.85f;
+    const float wrap = card_w - 2 * px(kCcPadX) - toggle_w - px(kCcToggleGap);
+    float h = 2 * px(kCcPadY) + ImGui::GetFrameHeight() * 0.9f;
+    if (desc && desc[0]) h += px(4) + ImGui::CalcTextSize(desc, nullptr, false, wrap).y * 0.92f;
+    std::vector<RecompLauncherCModOption> opts;
+    cc_card_options(m, it, &opts);
+    if (!opts.empty()) h += px(8) + (float)opts.size() * (ImGui::GetFrameHeight() + px(5));
+    return h + px(2);
+}
