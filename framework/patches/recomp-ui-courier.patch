+// ---- Mod rows ---------------------------------------------------------------
+// Every visible mod feature becomes a switch row plus one row per option, grouped
+// by the manifest's `group`. Changes go through PsxMenuHost::mod_set, which saves
+// them to mods/state.toml and applies them live when the plugin can. A change the
+// plugin cannot apply live is only saved: unlike the renderer rows, this menu does
+// not relaunch the game for it, so no progress is lost by touching a mod.
+struct ModRow {
+    std::string key, section, label, desc, pkg, feat, opt;
+    int kind = 0;             // 0 feature switch, 1 boolean, 2 choice, 3 integer
+    int feature_index = 0, option_index = 0;
+    std::vector<std::string> values, labels;
+    std::vector<const char *> label_ptrs;
+    int minv = 0, maxv = 1, step = 1;
+    int current = 0;
+};
+std::vector<ModRow> g_mod_rows;
+std::vector<RecompRuntimeUiItem> g_all_items;
+const RecompLauncherCModProvider *g_mods = nullptr;
+
+bool is_mod_item(const RecompRuntimeUiItem *item) {
+    return item && item->key && !std::strncmp(item->key, "mod.", 4);
+}
+size_t mod_index(const RecompRuntimeUiItem *item) {
+    return (size_t)std::strtoul(item->key + 4, nullptr, 10);
+}
+
+int parse_mod_value(const ModRow &r, const char *v) {
+    if (r.kind <= 1) return (!std::strcmp(v, "true") || !std::strcmp(v, "1")) ? 1 : 0;
+    if (r.kind == 2) {
+        for (size_t i = 0; i < r.values.size(); ++i)
+            if (r.values[i] == v) return (int)i;
+        return 0;
+    }
+    return std::atoi(v);
+}
+
+void refresh_mod_rows() {
+    if (!g_mods) return;
+    for (ModRow &r : g_mod_rows) {
+        if (r.kind == 0) {
+            RecompLauncherCModFeature f{};
+            if (g_mods->feature_get && g_mods->feature_get(g_mods->ctx, r.feature_index, &f))
+                r.current = f.enabled ? 1 : 0;
+            continue;
+        }
+        RecompLauncherCModOption o{};
+        if (g_mods->feature_option_get &&
+            g_mods->feature_option_get(g_mods->ctx, r.pkg.c_str(), r.feat.c_str(), r.option_index, &o))
+            r.current = parse_mod_value(r, o.value);
+    }
+}
+
+// Builds g_mod_rows and g_all_items (the stock extra rows first, then the mods).
+// Both outlive the menu: the model keeps pointers into them.
+void build_mod_rows(const RecompLauncherCModProvider *mods, size_t base_count) {
+    g_mod_rows.clear();
+    g_all_items.assign(g_extra, g_extra + base_count);
+    g_mods = mods;
+    if (mods && mods->feature_count && mods->feature_get && mods->feature_option_get) {
+        const int fc = mods->feature_count(mods->ctx);
+        for (int i = 0; i < fc; ++i) {
+            RecompLauncherCModFeature f{};
+            if (!mods->feature_get(mods->ctx, i, &f)) continue;
+            if (f.hidden || f.channel == RECOMP_MOD_CHANNEL_DEVELOPER) continue;
+            if (!std::strcmp(f.group, "Advanced")) continue;
+            const std::string section = f.group[0] ? f.group : "Mods";
+            ModRow sw;
+            sw.kind = 0;
+            sw.section = section;
+            sw.label = f.name;
+            sw.desc = std::string("Turn on or off (applies the next time the game starts). ") + f.description;
+            sw.pkg = f.package_id;
+            sw.feat = f.id;
+            sw.feature_index = i;
+            g_mod_rows.push_back(std::move(sw));
+            for (int j = 0; j < f.option_count; ++j) {
+                RecompLauncherCModOption o{};
+                if (!mods->feature_option_get(mods->ctx, f.package_id, f.id, j, &o)) continue;
+                ModRow r;
+                if (o.type == RECOMP_MOD_OPTION_BOOLEAN) r.kind = 1;
+                else if (o.type == RECOMP_MOD_OPTION_CHOICE) r.kind = 2;
+                else if (o.type == RECOMP_MOD_OPTION_INTEGER) r.kind = 3;
+                else continue;   // text and binding rows stay on the launcher's Mods page
+                r.section = section;
+                r.label = std::string(f.name) + " - " + o.label;
+                r.desc = o.description;
+                r.pkg = f.package_id;
+                r.feat = f.id;
+                r.opt = o.id;
+                r.feature_index = i;
+                r.option_index = j;
+                if (r.kind == 2) {
+                    for (int k = 0; k < o.choice_count; ++k) {
+                        RecompLauncherCModChoice c{};
+                        if (mods->feature_choice_get &&
+                            mods->feature_choice_get(mods->ctx, f.package_id, f.id, o.id, k, &c)) {
+                            r.values.push_back(c.value);
+                            r.labels.push_back(c.label[0] ? c.label : c.value);
+                        }
+                    }
+                    if (r.values.empty()) continue;
+                    r.minv = 0;
+                    r.maxv = (int)r.values.size() - 1;
+                } else if (r.kind == 3) {
+                    r.minv = (int)o.min_value;
+                    r.maxv = (int)o.max_value;
+                    r.step = o.step > 0 ? (int)o.step : 1;
+                }
+                g_mod_rows.push_back(std::move(r));
+            }
+        }
+    }
+    // Second pass: the vector no longer changes, so pointers into it stay valid.
+    for (size_t i = 0; i < g_mod_rows.size(); ++i) {
+        ModRow &r = g_mod_rows[i];
+        r.key = "mod." + std::to_string(i);
+        r.label_ptrs.clear();
+        for (const std::string &s : r.labels) r.label_ptrs.push_back(s.c_str());
+        RecompRuntimeUiItem it{};
+        it.key = r.key.c_str();
+        it.section = r.section.c_str();
+        it.label = r.label.c_str();
+        it.description = r.desc.c_str();
+        it.type = r.kind == 2 ? RECOMP_RUNTIME_UI_CHOICE
+                : r.kind == 3 ? RECOMP_RUNTIME_UI_INT
+                              : RECOMP_RUNTIME_UI_BOOL;
+        it.minimum = r.minv;
+        it.maximum = r.maxv;
+        it.step = r.step;
+        it.choices = r.kind == 2 ? r.label_ptrs.data() : nullptr;
+        it.choice_count = r.kind == 2 ? r.label_ptrs.size() : 0;
+        it.choice_values = nullptr;
+        g_all_items.push_back(it);
+    }
+    refresh_mod_rows();
+}
+
+int set_mod_row(size_t idx, int v) {
+    if (idx >= g_mod_rows.size() || !g_host || !g_host->mod_set) return 0;
+    ModRow &r = g_mod_rows[idx];
+    std::string val;
+    if (r.kind <= 1) val = v ? "true" : "false";
+    else if (r.kind == 2) {
+        if (v < 0 || (size_t)v >= r.values.size()) return 0;
+        val = r.values[(size_t)v];
+    } else val = std::to_string(v);
+    const int live = g_host->mod_set(r.pkg.c_str(), r.feat.c_str(),
+                                     r.kind == 0 ? nullptr : r.opt.c_str(), val.c_str());
+    r.current = v;
+    status(live ? "Applied" : "Saved. Applies the next time the game starts.");
+    return 1;
+}
