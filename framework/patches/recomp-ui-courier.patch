+static void draw_enhancements(LauncherModel* m, const LauncherTheme& th) {
+    const auto* mods = m ? m->mods : nullptr;
+    if (!m || !mods || !mods->feature_count || !mods->feature_get || !mods->feature_option_get ||
+        !mods->feature_enable || !mods->feature_set_option) return;
+
+    // Profiles -------------------------------------------------------------
+    const int current = cc_current_profile(m);
+    {
+        const float gap = px(12);
+        const float cw = (ImGui::GetContentRegionAvail().x - gap * 2) / 3.0f;
+        for (int i = 0; i < 3; ++i) {
+            if (i) ImGui::SameLine(0, gap);
+            cc_profile_card(m, th, i, i == current, cw);
+        }
+    }
+    ImGui::Dummy(ImVec2(0, px(2)));
+    ImGui::PushStyleColor(ImGuiCol_Text, col(current >= 0 ? th.good : th.text_muted));
+    ImGui::Text("%s: %s", launcher_i18n_pair("Current profile", "Perfil atual"), cc_profile_name(current));
+    ImGui::PopStyleColor();
+    ImGui::SameLine();
+    ImGui::PushStyleColor(ImGuiCol_Text, col(th.text_muted));
+    ImGui::TextUnformatted(launcher_i18n_pair(
+        "  -  changes are saved at once and apply the next time the game starts",
+        "  -  as mudanças são salvas na hora e valem na próxima vez que o jogo iniciar"));
+    ImGui::PopStyleColor();
+    if (m->mod_status[0]) {
+        ImGui::PushStyleColor(ImGuiCol_Text, col(th.warn));
+        ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + ImGui::GetContentRegionAvail().x);
+        ImGui::TextWrapped("%s", m->mod_status);
+        ImGui::PopTextWrapPos();
+        ImGui::PopStyleColor();
+    }
+
+    // Gather every listed feature, in table order -----------------------------
+    std::vector<CcListed> items;
+    for (int i = 0, n = mods->feature_count(mods->ctx); i < n; ++i) {
+        CcListed it{};
+        if (!mods->feature_get(mods->ctx, i, &it.f) || !launcher_mod_feature_listed(mods, &it.f)) continue;
+        if (cc_is_linked_child(it.f.package_id, it.f.id)) continue;
+        if (it.f.hidden && !cc_row_for(it.f.package_id, it.f.id)) continue;   // internal helpers
+        it.row = cc_row_for(it.f.package_id, it.f.id);
+        it.section = it.row ? it.row->section : CC_OTHER;
+        it.order = it.row ? (int)(it.row - kCcRows) : 1000 + i;
+        items.push_back(it);
+    }
+    std::stable_sort(items.begin(), items.end(),
+                     [](const CcListed& a, const CcListed& b) { return a.order < b.order; });
+
+    static const char* kTitleEn[CC_SECTION_COUNT] = {"PICTURE", "MOTION", "AUDIO", "FILTERS AND EFFECTS", "EXTRAS", "ADVANCED", "OTHER"};
+    static const char* kTitlePt[CC_SECTION_COUNT] = {"IMAGEM", "MOVIMENTO", "ÁUDIO", "FILTROS E EFEITOS", "EXTRAS", "AVANÇADO", "OUTROS"};
+    const bool pt = std::strcmp(launcher_i18n_language(), "pt") == 0;
+    const float gap = px(12);
+
+    for (int s = 0; s < CC_SECTION_COUNT; ++s) {
+        std::vector<const CcListed*> cards;
+        for (const CcListed& it : items) if (it.section == s) cards.push_back(&it);
+        if (cards.empty()) continue;
+        if (s == CC_ADVANCED) {
+            ImGui::Dummy(ImVec2(0, px(8)));
+            if (ImGui::Button(cc_show_advanced
+                    ? launcher_i18n_pair("Hide advanced options", "Ocultar opções avançadas")
+                    : launcher_i18n_pair("Show advanced options", "Mostrar opções avançadas")))
+                cc_show_advanced = !cc_show_advanced;
+            if (!cc_show_advanced) continue;
+        }
+        cc_section_heading(pt ? kTitlePt[s] : kTitleEn[s], th);
+        const float cw = (ImGui::GetContentRegionAvail().x - gap) * 0.5f;
+        for (size_t k = 0; k < cards.size(); k += 2) {
+            float h = cc_card_height(m, *cards[k], cw);
+            if (k + 1 < cards.size()) h = std::max(h, cc_card_height(m, *cards[k + 1], cw));
+            cc_draw_card(m, th, *cards[k], cw, h);
+            if (k + 1 < cards.size()) {
+                ImGui::SameLine(0, gap);
+                cc_draw_card(m, th, *cards[k + 1], cw, h);
+            }
+            ImGui::Dummy(ImVec2(0, px(2)));
+        }
+    }
+    ImGui::Dummy(ImVec2(0, px(8)));
+}
