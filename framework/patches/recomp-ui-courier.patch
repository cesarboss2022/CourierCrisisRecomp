+bool is_mod_item(const RecompRuntimeUiItem *item) {
+    return item && item->key && !std::strncmp(item->key, "mod.", 4);
+}
+size_t mod_index(const RecompRuntimeUiItem *item) {
+    return (size_t)std::strtoul(item->key + 4, nullptr, 10);
+}
