+    t.panel           = lng_rgba(0.122f, 0.114f, 0.102f, 1.0f); // #1F1D1A card
+    t.panel_hovered   = lng_rgba(0.180f, 0.165f, 0.141f, 1.0f); // #2E2A24
+    t.control         = lng_rgba(0.153f, 0.141f, 0.125f, 1.0f); // #272420 button
+    t.control_hovered = lng_rgba(0.220f, 0.200f, 0.169f, 1.0f); // #38332B
