+// One option inside a card: a label on the left, its control on the right.
+static void cc_card_option(LauncherModel* m, const RecompLauncherCModFeature& f,
+                           const RecompLauncherCModOption& o, float inner_w) {
+    const auto* mods = m->mods;
+    const float ctl_w = px(180);
+    ImGui::PushID(o.id);
+    const bool inert = o.disabled != 0;
+    if (inert) ImGui::BeginDisabled();
+    char next[RECOMP_LAUNCHER_MOD_VALUE_MAX];
+    std::snprintf(next, sizeof(next), "%s", o.value);
+    bool changed = false;
+    if (o.type == RECOMP_MOD_OPTION_CHOICE) {
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextUnformatted(o.label);
+        ImGui::SameLine(inner_w - ctl_w);
+        ImGui::SetNextItemWidth(ctl_w);
+        char preview[128];
+        std::snprintf(preview, sizeof(preview), "%s", o.value);
+        for (int c = 0; c < o.choice_count; ++c) {
+            RecompLauncherCModChoice ch{};
+            if (mods->feature_choice_get &&
+                mods->feature_choice_get(mods->ctx, f.package_id, f.id, o.id, c, &ch) &&
+                !std::strcmp(ch.value, o.value)) {
+                std::snprintf(preview, sizeof(preview), "%s", ch.label[0] ? ch.label : ch.value);
+                break;
+            }
+        }
+        if (ImGui::BeginCombo("##c", preview)) {
+            for (int c = 0; c < o.choice_count; ++c) {
+                RecompLauncherCModChoice ch{};
+                if (!mods->feature_choice_get ||
+                    !mods->feature_choice_get(mods->ctx, f.package_id, f.id, o.id, c, &ch)) continue;
+                const bool sel = !std::strcmp(ch.value, o.value);
+                if (ImGui::Selectable(ch.label, sel)) {
+                    std::snprintf(next, sizeof(next), "%s", ch.value);
+                    changed = true;
+                }
+                if (sel) ImGui::SetItemDefaultFocus();
+            }
+            ImGui::EndCombo();
+        }
+    } else if (o.type == RECOMP_MOD_OPTION_BOOLEAN) {
+        bool v = !std::strcmp(o.value, "true");
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextUnformatted(o.label);
+        ImGui::SameLine(inner_w - ImGui::GetFrameHeight() * 0.82f * 1.85f);
+        if (ImGui::Checkbox("##b", &v)) {
+            std::snprintf(next, sizeof(next), "%s", v ? "true" : "false");
+            changed = true;
+        }
+    } else {
+        draw_mod_feature_option(m, f, o);   // integers and anything else: the stock control
+    }
+    const bool hovered = ImGui::IsItemHovered();
+    if (inert) ImGui::EndDisabled();
+    if (hovered) mod_option_tooltip(o);
+    if (changed && !inert &&
+        !mods->feature_set_option(mods->ctx, f.package_id, f.id, o.id, next))
+        mod_note_error(m);
+    ImGui::PopID();
+}
