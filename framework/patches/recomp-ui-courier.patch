+// Features that follow another switch and are never listed by themselves.
+static bool cc_is_linked_child(const char* pkg, const char* feat) {
+    for (const CcRow& r : kCcRows) {
+        if (r.linked_feat && !std::strcmp(r.linked_feat, feat) && !std::strcmp(r.linked_pkg, pkg)) return true;
+        if (r.linked_feat2 && !std::strcmp(r.linked_feat2, feat) && !std::strcmp(r.linked_pkg2, pkg)) return true;
+    }
+    return false;
+}
+
+static const CcRow* cc_row_for(const char* pkg, const char* feat) {
+    for (const CcRow& r : kCcRows)
+        if (!std::strcmp(r.feat, feat) && !std::strcmp(r.pkg, pkg)) return &r;
+    return nullptr;
+}
