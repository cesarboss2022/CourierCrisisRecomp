+static void cc_localize_option(const RecompLauncherCModFeature& f, RecompLauncherCModOption* o) {
+    if (std::strcmp(launcher_i18n_language(), "pt") != 0) return;
+    for (const CcOptText& t : kCcOptText) {
+        if (std::strcmp(t.feat, f.id) || std::strcmp(t.opt, o->id)) continue;
+        if (t.label_pt) std::snprintf(o->label, sizeof(o->label), "%s", t.label_pt);
+        if (t.desc_pt) std::snprintf(o->description, sizeof(o->description), "%s", t.desc_pt);
+        return;
+    }
+}
