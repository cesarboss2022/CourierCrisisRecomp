+// ---- provider access --------------------------------------------------------
+static bool cc_find_feature(const LauncherModel* m, const char* pkg, const char* feat,
+                            RecompLauncherCModFeature* out) {
+    const auto* mods = m ? m->mods : nullptr;
+    if (!mods || !mods->feature_count || !mods->feature_get) return false;
+    for (int i = 0, n = mods->feature_count(mods->ctx); i < n; ++i) {
+        RecompLauncherCModFeature f{};
+        if (mods->feature_get(mods->ctx, i, &f) && !std::strcmp(f.id, feat) &&
+            !std::strcmp(f.package_id, pkg)) {
+            *out = f;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool cc_get_option(const LauncherModel* m, const RecompLauncherCModFeature& f,
+                          const char* opt, char* out, size_t cap) {
+    const auto* mods = m->mods;
+    for (int j = 0; j < f.option_count; ++j) {
+        RecompLauncherCModOption o{};
+        if (mods->feature_option_get(mods->ctx, f.package_id, f.id, j, &o) && !std::strcmp(o.id, opt)) {
+            std::snprintf(out, cap, "%s", o.value);
+            return true;
+        }
+    }
+    return false;
+}
+
+static void cc_enable(LauncherModel* m, const char* pkg, const char* feat, bool on) {
+    RecompLauncherCModFeature f{};
+    if (!cc_find_feature(m, pkg, feat, &f)) return;
+    if (f.enabled == (on ? 1 : 0)) return;
+    if (!launcher_mod_enable_feature(m, &f, on ? 1 : 0)) mod_note_error(m);
+}
+
+static void cc_option(LauncherModel* m, const char* pkg, const char* feat, const char* opt, const char* val) {
+    RecompLauncherCModFeature f{};
+    if (!cc_find_feature(m, pkg, feat, &f)) return;
+    char cur[RECOMP_LAUNCHER_MOD_VALUE_MAX];
+    if (cc_get_option(m, f, opt, cur, sizeof(cur)) && !std::strcmp(cur, val)) return;
+    if (!m->mods->feature_set_option(m->mods->ctx, pkg, feat, opt, val)) mod_note_error(m);
+}
