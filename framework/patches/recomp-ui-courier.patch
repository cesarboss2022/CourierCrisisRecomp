+static void cc_draw_card(LauncherModel* m, const LauncherTheme& th, const CcListed& it,
+                         float w, float h) {
+    const RecompLauncherCModFeature& f = it.f;
+    const CcRow* row = it.row;
+    const bool pt = std::strcmp(launcher_i18n_language(), "pt") == 0;
+    const char* name = row ? (pt ? row->name_pt : row->name_en) : f.name;
+    const char* desc = row ? (pt ? row->desc_pt : row->desc_en) : f.description;
+    char id[160];
+    std::snprintf(id, sizeof(id), "##card_%s_%s", f.package_id, f.id);
+
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(px(kCcPadX), px(kCcPadY)));
+    ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, px(10));
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, col(f.enabled ? th.panel_hovered : th.panel));
+    ImGui::PushStyleColor(ImGuiCol_Border, imcol(f.enabled ? th.accent : th.border, f.enabled ? 0.55f : 0.9f));
+    ImGui::BeginChild(id, ImVec2(w, h), ImGuiChildFlags_Borders,
+                      ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+    const float inner = ImGui::GetContentRegionAvail().x;
+    const float toggle_w = ImGui::GetFrameHeight() * 0.82f * 1.85f;
+    const float top = ImGui::GetCursorPosY();
+
+    ImGui::PushStyleColor(ImGuiCol_Text, col(th.text));
+    ImGui::SetWindowFontScale(1.06f);
+    ImGui::TextUnformatted(name);
+    ImGui::SetWindowFontScale(1.0f);
+    ImGui::PopStyleColor();
+    if (f.has_error) {
+        ImGui::SameLine();
+        ImGui::TextColored(col(th.warn), "!");
+        if (ImGui::IsItemHovered() && f.status[0]) ImGui::SetTooltip("%s", f.status);
+    }
+    ImGui::SetCursorPos(ImVec2(px(kCcPadX) + inner - toggle_w, top));
+    ImGui::PushID(id);
+    bool on = f.enabled != 0;
+    if (cc_toggle("##on", &on, th)) {
+        change_mod_feature(m, f, on);
+        if (row) {
+            if (row->linked_feat) cc_enable(m, row->linked_pkg, row->linked_feat, on);
+            if (row->linked_feat2) cc_enable(m, row->linked_pkg2, row->linked_feat2, on);
+        }
+    }
+    ImGui::PopID();
+    ImGui::SetCursorPos(ImVec2(px(kCcPadX), top + ImGui::GetFrameHeight() * 0.9f + px(4)));
+    if (desc && desc[0]) {
+        ImGui::PushStyleColor(ImGuiCol_Text, col(th.text_muted));
+        ImGui::PushTextWrapPos(px(kCcPadX) + inner - toggle_w - px(kCcToggleGap));
+        ImGui::SetWindowFontScale(0.92f);
+        ImGui::TextWrapped("%s", desc);
+        ImGui::SetWindowFontScale(1.0f);
+        ImGui::PopTextWrapPos();
+        ImGui::PopStyleColor();
+    }
+    std::vector<RecompLauncherCModOption> opts;
+    cc_card_options(m, it, &opts);
+    if (!opts.empty()) {
+        ImGui::Dummy(ImVec2(0, px(4)));
+        ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(px(8), px(2)));
+        ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(px(8), px(5)));
+        ImGui::SetWindowFontScale(0.92f);
+        for (const auto& o : opts) cc_card_option(m, f, o, inner);
+        ImGui::SetWindowFontScale(1.0f);
+        ImGui::PopStyleVar(2);
+    }
+    ImGui::EndChild();
+    ImGui::PopStyleColor(2);
+    ImGui::PopStyleVar(2);
+}
