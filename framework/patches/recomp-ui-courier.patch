+static void cc_apply_profile(LauncherModel* m, const CcProfile& p) {
+    for (int i = 0; i < p.count; ++i) {
+        const CcStep& s = p.steps[i];
+        if (s.enabled >= 0) cc_enable(m, s.pkg, s.feat, s.enabled != 0);
+        if (s.opt) cc_option(m, s.pkg, s.feat, s.opt, s.val);
+    }
+    if (m->has_bios && m->bios_verify_for_rom_cb) launcher_model_refresh_bios_status(m);
+}
+
+static bool cc_profile_matches(const LauncherModel* m, const CcProfile& p) {
+    for (int i = 0; i < p.count; ++i) {
+        const CcStep& s = p.steps[i];
+        RecompLauncherCModFeature f{};
+        if (!cc_find_feature(m, s.pkg, s.feat, &f)) continue;   // not in this build
+        if (s.enabled >= 0 && (f.enabled != 0) != (s.enabled != 0)) return false;
+        if (s.opt && s.enabled != 0) {
+            char cur[RECOMP_LAUNCHER_MOD_VALUE_MAX];
+            if (!cc_get_option(m, f, s.opt, cur, sizeof(cur)) || std::strcmp(cur, s.val)) return false;
+        }
+    }
+    return true;
+}
+
+// -1 = custom
+static int cc_current_profile(const LauncherModel* m) {
+    for (int i = 0; i < 3; ++i)
+        if (cc_profile_matches(m, kCcProfiles[i])) return i;
+    return -1;
+}
