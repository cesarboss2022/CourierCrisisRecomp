+
+// Pick a built-in theme by name ("courier" -> Courier Crisis, "psx" -> PlayStation, "gba" -> Game Boy
 // Advance, "gbc" -> Game Boy Color, "gb" -> Game Boy (DMG), "n64" -> Nintendo
 // 64, "nes" -> Nintendo Entertainment System, "genesis" -> Sega Genesis;
