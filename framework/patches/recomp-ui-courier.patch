+// Draws `text` on one line, cut with "..." where it would pass `max_w`.
+void draw_ellipsized(ImDrawList *draw, ImVec2 pos, float max_w, ImU32 color,
+                     const char *text) {
+    if (ImGui::CalcTextSize(text).x <= max_w) {
+        draw->AddText(pos, color, text);
+        return;
+    }
+    std::string cut(text);
+    while (!cut.empty() &&
+           ImGui::CalcTextSize((cut + "...").c_str()).x > max_w) {
+        cut.pop_back();
+        // Never end inside a multi-byte UTF-8 sequence.
+        while (!cut.empty() &&
+               (static_cast<unsigned char>(cut.back()) & 0xC0) == 0x80)
+            cut.pop_back();
+    }
+    cut += "...";
+    draw->AddText(pos, color, cut.c_str());
+}
